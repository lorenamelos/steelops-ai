# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environment and secrets
.env
.env.*
!.env.example

# Data: raw and derived files are reproduced by scripts, never committed.
# MANIFEST.json is committed so provenance and checksums are reviewable in Git.
data/raw/*
!data/raw/.gitkeep
!data/raw/MANIFEST.json
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated reports (regenerated by `steelops-audit` / EDA script)
reports/figures/*.html
reports/data_audit.json

# Model artifacts
models/
*.joblib
*.pkl

# OS / editor
.DS_Store
.idea/
.vscode/
